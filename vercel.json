{
  "version": 2,
  "installCommand": "cd web && npm install --legacy-peer-deps",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/.next",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false,
      "preview-test": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- web/ backend/ .github/"
}
